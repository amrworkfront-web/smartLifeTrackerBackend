# Smart Life Tracker - Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<cluster>

JWT_ACCESS_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_64_CHARS

ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

CLIENT_URL=https://smartlifetrackerfrontend.vercel.app
CORS_ORIGINS=https://smartlifetrackerfrontend.vercel.app,http://localhost:3000

NODE_ENV=development
